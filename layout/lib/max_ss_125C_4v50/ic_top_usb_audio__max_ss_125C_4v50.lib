          values("0.17460,0.20680,0.30560,0.47719,0.73681,1.11601,1.63499,2.29901,3.12198,4.10101");
	}
      }
    }
    pin("RESET_N") {
      direction : input;
      capacitance : 0.0042;
    }
    pin("SYS_CLK_60M") {
      direction : input;
      capacitance : 0.0040;
    }
    pin("USB_DN") {
      direction : inout;
      capacitance : 0.0879;
    }
    pin("USB_DP") {
      direction : inout;
