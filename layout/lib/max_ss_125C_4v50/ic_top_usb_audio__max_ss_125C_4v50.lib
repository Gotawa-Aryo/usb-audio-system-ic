          values("10.84739,10.87759,10.97466,11.15293,11.42893,11.81593,12.32658,12.96924,13.75262,14.68993");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00270,  0.00866,  0.02005,  0.03778,  0.06267,  0.09542,  0.13670,  0.18700,  0.24710");
          values("0.14687,0.19067,0.34473,0.65473,1.15000,1.84631,2.76331,3.91693,5.32238,7.00665");
	}
	cell_fall(template_1) {
