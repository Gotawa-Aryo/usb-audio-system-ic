          values("0.17455,0.20683,0.30560,0.47720,0.73688,1.11600,1.63513,2.29913,3.12187,4.10113");
	}
      }
    }
    pin("RESET_N") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("SYS_CLK_60M") {
      direction : input;
      capacitance : 0.0039;
    }
    pin("USB_DN") {
      direction : inout;
      capacitance : 0.0870;
    }
    pin("USB_DP") {
      direction : inout;
