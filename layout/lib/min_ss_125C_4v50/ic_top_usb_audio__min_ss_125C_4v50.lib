        timing_sense : positive_unate;
        timing_type : combinational;
	cell_rise(template_1) {
          index_1("0.00100,  0.00270,  0.00866,  0.02005,  0.03778,  0.06267,  0.09542,  0.13670,  0.18700,  0.24710");
          values("10.07138,10.10158,10.19871,10.37703,10.65303,11.04003,11.55039,12.19275,12.97732,13.91403");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.00270,  0.00866,  0.02005,  0.03778,  0.06267,  0.09542,  0.13670,  0.18700,  0.24710");
          values("0.14693,0.19073,0.34467,0.65467,1.15000,1.84572,2.76272,3.91515,5.32356,7.00636");
	}
	cell_fall(template_1) {
