	fall_transition(template_1) {
          index_1("0.00100,  0.00270,  0.00866,  0.02005,  0.03778,  0.06267,  0.09542,  0.13670,  0.18700,  0.24710");
          values("0.17450,0.20685,0.30560,0.47720,0.73695,1.11600,1.63524,2.29924,3.12176,4.10124");
	}
      }
    }
    pin("RESET_N") {
      direction : input;
      capacitance : 0.0039;
    }
    pin("SYS_CLK_60M") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("USB_DN") {
      direction : inout;
      capacitance : 0.0862;
    }
    pin("USB_DP") {
      direction : inout;
      capacitance : 0.0784;
    }
    pin("USB_DP_PULL") {
